---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Personal Site', description = 'Personal branding site' } = Astro.props;
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0b1020;
        --card: #141a2f;
        --text: #eef2ff;
        --muted: #a5b4d4;
        --accent: #7c9cff;
        --border: #243056;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", system-ui, sans-serif;
        background: radial-gradient(circle at top, #17203a, var(--bg) 45%);
        color: var(--text);
        min-height: 100vh;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      main { width: min(920px, 92vw); margin: 0 auto; padding: 2rem 0 4rem; }
      .card {
        background: color-mix(in srgb, var(--card) 92%, white 8%);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
      }
      nav {
        display: flex; gap: 1rem; flex-wrap: wrap;
        width: min(920px, 92vw); margin: 0 auto; padding: 1.25rem 0;
        border-bottom: 1px solid var(--border);
      }
      nav a { color: var(--muted); font-weight: 600; }
      nav a[aria-current="page"] { color: var(--text); }
      h1, h2 { line-height: 1.2; }
      p, li { color: var(--muted); line-height: 1.6; }
      input, textarea, button {
        font: inherit; border-radius: 10px; border: 1px solid var(--border);
        background: #0f1528; color: var(--text); padding: 0.7rem 0.9rem; width: 100%;
      }
      button { background: var(--accent); color: #081018; font-weight: 700; cursor: pointer; width: auto; }
      input, textarea { border-color: #6b7bab; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .req { color: var(--muted); font-weight: 400; font-size: 0.9em; }
      .field-error { color: #ffb4b4; margin: 0.35rem 0 0; }
      [aria-invalid="true"] { border-color: #ff8a8a; }
      .skip-link {
        position: absolute; left: 1rem; top: -3rem; z-index: 10;
        background: var(--accent); color: #081018; font-weight: 700;
        padding: 0.5rem 0.9rem; border-radius: 10px;
      }
      .skip-link:focus { top: 1rem; }
      #main:focus { outline: none; }
      label { display: block; margin: 0.75rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav aria-label="หลัก">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
      <a href="/about" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
      <a href="/interests" aria-current={Astro.url.pathname.startsWith('/interests') ? 'page' : undefined}>Interests</a>
      <a href="/contact" aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}>Contact</a>
      <a href="/guestbook" aria-current={Astro.url.pathname.startsWith('/guestbook') ? 'page' : undefined}>Guestbook</a>
    </nav>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
