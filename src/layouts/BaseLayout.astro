---
import { loadProfile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}
const profile = loadProfile();
const {
  title = profile.name,
  description = `${profile.tagline} — ${profile.headline}`,
} = Astro.props;

const path = Astro.url.pathname;
const current = (href: string) =>
  (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`)) ? 'page' : undefined;

// D8 menu (Playbook · About · Contact) + Interests anchor on About + Guestbook link.
// Guestbook is Out of scope v1 in DECISIONS; the page only shows a polite "not open" state until backend + moderation exist.
const links = [
  { href: '/playbook', label: 'Playbook' },
  { href: '/about', label: 'เกี่ยวกับผม' },
  { href: '/about#interests', label: 'เรื่องที่สนใจ', anchor: true },
  { href: '/contact', label: 'ติดต่อ' },
  { href: '/guestbook', label: 'สมุดเยี่ยม' },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      /* D13: warm off-white by default, dark via prefers-color-scheme. D14: text contrast >= 4.5:1. */
      :root {
        --bg: #faf7f2;
        --surface: #ffffff;
        --text: #1f2328;
        --muted: #4a4f57;
        --accent: #1d5a8a;
        --accent-contrast: #ffffff;
        --border: #e2dacd;
        --notice-bg: #fff4dc;
        --notice-border: #d9b25c;
        --focus: #b35c00;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16181c;
          --surface: #1f2227;
          --text: #ece9e4;
          --muted: #b8b3ab;
          --accent: #8cc4f0;
          --accent-contrast: #0f141a;
          --border: #343841;
          --notice-bg: #3a3020;
          --notice-border: #a8843a;
          --focus: #ffb35c;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "Noto Sans Thai", "Sarabun", system-ui, sans-serif;
        font-size: 1.0625rem;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
      }
      a { color: var(--accent); text-underline-offset: 0.2em; }
      a:hover { text-decoration-thickness: 2px; }
      :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
      .skip-link { position: absolute; left: -9999px; }
      .skip-link:focus { left: 1rem; top: 1rem; background: var(--surface); padding: 0.5rem 1rem; z-index: 10; }
      header.site { border-bottom: 1px solid var(--border); }
      nav {
        display: flex; gap: 0.5rem 1.25rem; flex-wrap: wrap; align-items: baseline;
        width: min(820px, 92vw); margin: 0 auto; padding: 1rem 0;
      }
      nav .home { color: var(--text); font-weight: 700; text-decoration: none; margin-right: auto; }
      nav a { color: var(--muted); font-weight: 600; text-decoration: none; }
      nav a:hover { color: var(--text); text-decoration: underline; }
      nav a[aria-current="page"] { color: var(--text); text-decoration: underline; text-decoration-thickness: 2px; }
      main { width: min(820px, 92vw); margin: 0 auto; padding: 2rem 0 4rem; }
      footer.site { width: min(820px, 92vw); margin: 0 auto; padding: 1.5rem 0 2.5rem; border-top: 1px solid var(--border); }
      footer.site p { font-size: 0.9rem; margin: 0; }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
      }
      h1, h2, h3 { line-height: 1.3; color: var(--text); }
      p, li { color: var(--muted); line-height: 1.75; }
      .notice {
        background: var(--notice-bg); border: 1px solid var(--notice-border);
        border-radius: 10px; padding: 0.75rem 1rem; color: var(--text); margin: 0 0 1rem;
      }
      .hint { font-size: 0.9rem; margin: 0.3rem 0 0; }
      .btn {
        display: inline-block; background: var(--accent); color: var(--accent-contrast);
        font-weight: 700; padding: 0.7rem 1.2rem; border-radius: 10px; text-decoration: none; border: 0;
      }
      .btn:hover { text-decoration: underline; }
      fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
      input, textarea, button {
        font: inherit; border-radius: 10px; border: 1px solid var(--border);
        background: var(--bg); color: var(--text); padding: 0.7rem 0.9rem; width: 100%;
      }
      input::placeholder, textarea::placeholder { color: var(--muted); }
      button { background: var(--accent); color: var(--accent-contrast); font-weight: 700; cursor: pointer; width: auto; border: 0; }
      button:disabled, fieldset:disabled input, fieldset:disabled textarea { opacity: 0.6; cursor: not-allowed; }
      label { display: block; margin: 1rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      .grid a.card { text-decoration: none; display: block; margin: 0; }
      .grid a.card h2 { color: var(--accent); font-size: 1.15rem; margin: 0 0 0.35rem; }
      .grid a.card p { margin: 0; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">ข้ามไปที่เนื้อหา</a>
    <header class="site">
      <nav aria-label="เมนูหลัก">
        <a class="home" href="/" aria-current={current('/')}>{profile.name}</a>
        {links.map((l) => (
          <a href={l.href} aria-current={l.anchor ? undefined : current(l.href)}>{l.label}</a>
        ))}
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site">
      <p>{profile.name} · {profile.headline}</p>
    </footer>
  </body>
</html>
