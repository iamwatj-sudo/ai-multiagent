---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, paragraphs } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout title={`เกี่ยวกับผม · ${profile.name}`}>
  <!-- D8: full Bio + Interests live here (interests page removed). -->
  <article class="card">
    <h1>เกี่ยวกับผม</h1>
    {paragraphs(profile.bio).map((p) => <p>{p}</p>)}
  </article>

  <section class="card" id="interests" aria-labelledby="interests-title">
    <h2 id="interests-title">เรื่องที่ผมสนใจ</h2>
    <ul>
      {profile.interests.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="card" aria-labelledby="next">
    <h2 id="next">อ่านต่อ</h2>
    <p><a href="/playbook">Playbook: ย้าย Web Forms ทีละส่วน</a> · <a href="/contact">ติดต่อผม</a></p>
  </section>
</BaseLayout>
