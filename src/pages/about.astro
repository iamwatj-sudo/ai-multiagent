---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout title={`About · ${profile.name}`}>
  <article class="card">
    <h1>About</h1>
    {profile.bio.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
    <p>เรื่องราวเพิ่มเติม — timeline, skills และลิงก์จะอัปเดตเร็ว ๆ นี้</p>
  </article>
</BaseLayout>

