---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
import { CONTACT_FORM_OPEN } from '../lib/features';
const profile = loadProfile();
// D9 labels/copy · D10 closed state driven by CONTACT_FORM_OPEN · D11 purpose notice (no retention period yet) · D16 no raw email.
---
<BaseLayout title={`ติดต่อ · ${profile.name}`}>
  <section class="card">
    <h1>ติดต่อผม</h1>
    <p>ถามคำถามเรื่องการย้ายระบบ หรือเสนอหัวข้อที่อยากให้ผมเขียน</p>

    {!CONTACT_FORM_OPEN && (
      <p class="notice" id="form-closed">ยังไม่เปิดรับข้อความ</p>
    )}

    <form id="contact-form" data-open={CONTACT_FORM_OPEN ? 'true' : 'false'}>
      <fieldset disabled={!CONTACT_FORM_OPEN} aria-describedby={CONTACT_FORM_OPEN ? undefined : 'form-closed'}>
        <label for="name">ชื่อ</label>
        <input id="name" name="name" required maxlength="80" autocomplete="name" />

        <label for="email">อีเมล</label>
        <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" aria-describedby="email-hint" />
        <p class="hint" id="email-hint">ใช้ตอบกลับเท่านั้น ไม่แสดงบนเว็บ</p>

        <label for="message">ข้อความ</label>
        <textarea id="message" name="message" rows="6" required maxlength="2000" placeholder="ถามคำถาม หรือเสนอหัวข้อที่อยากให้เขียน"></textarea>

        <p style="margin-top:1rem"><button type="submit">ส่งข้อความ</button></p>
      </fieldset>
      <p id="status" role="status" aria-live="polite"></p>
    </form>

    <p class="hint">ข้อมูลที่คุณกรอก (ชื่อ อีเมล ข้อความ) ใช้เพื่อตอบกลับคุณเท่านั้น</p>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('status');
  const fieldset = form?.querySelector('fieldset');

  const MESSAGES = {
    sending: 'กำลังส่ง…',
    ok: 'ได้รับข้อความแล้ว ผมจะตอบกลับทางอีเมลที่คุณให้ไว้',
    closed: 'ตอนนี้ยังไม่เปิดรับข้อความ ข้อความของคุณยังไม่ถูกส่ง',
    invalid: 'ข้อมูลบางช่องยังไม่ถูกต้อง ลองตรวจอีกครั้ง',
    failed: 'ส่งไม่สำเร็จ ลองใหม่อีกครั้งภายหลัง',
    network: 'เชื่อมต่อไม่ได้ ลองใหม่อีกครั้ง',
  };

  const say = (text: string) => { if (status) status.textContent = text; };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.dataset.open !== 'true') { say(MESSAGES.closed); return; }
    if (!form.reportValidity()) return;
    const payload = Object.fromEntries(new FormData(form).entries());
    say(MESSAGES.sending);
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      // Never show raw API errors (D9) — map status codes to Thai copy.
      if (res.ok) { say(MESSAGES.ok); form.reset(); return; }
      if (res.status === 501) {
        say(MESSAGES.closed);
        if (fieldset) fieldset.disabled = true;
        return;
      }
      say(res.status === 400 ? MESSAGES.invalid : MESSAGES.failed);
    } catch {
      say(MESSAGES.network);
    }
  });
</script>
