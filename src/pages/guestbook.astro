---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Guestbook">
  <section class="card">
    <h1>Guestbook</h1>
    <p>ฝากข้อความไว้ได้ทางฟอร์มนี้ — อ่าน/เขียนผ่าน <code>/api/guestbook</code></p>
    <form id="gb-form">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" />
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <p style="margin-top:1rem"><button type="submit">Sign</button></p>
    </form>
    <div id="entries" class="card" style="margin-top:1.25rem" aria-live="polite">Loading…</div>
  </section>
</BaseLayout>
<script>
  const entries = document.getElementById('entries');
  const form = document.getElementById('gb-form');
  async function load() {
    const res = await fetch('/api/guestbook');
    const data = await res.json();
    if (!res.ok) {
      entries.textContent = data.error || `HTTP ${res.status}`;
      return;
    }
    const list = data.entries || [];
    if (!list.length) {
      entries.replaceChildren(Object.assign(document.createElement('p'), { textContent: 'No entries yet.' }));
      return;
    }
    entries.replaceChildren(...list.map((e) => {
      const p = document.createElement('p');
      const name = document.createElement('strong');
      name.textContent = e.name;
      const when = document.createElement('small');
      when.textContent = e.created_at;
      p.append(name, `: ${e.message}`, document.createElement('br'), when);
      return p;
    }));
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    await fetch('/api/guestbook', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    });
    form.reset();
    await load();
  });
  load();
</script>

