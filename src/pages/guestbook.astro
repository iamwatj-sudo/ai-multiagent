---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout title={`Guestbook · ${profile.name}`}>
  <section class="card">
    <h1>Guestbook</h1>
    <p>ฝากคำทักทายไว้ได้ทางฟอร์มนี้</p>
    <form id="gb-form">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" autocomplete="name" />
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <p style="margin-top:1rem"><button type="submit">Sign</button></p>
      <p id="gb-status" role="status" aria-live="polite"></p>
    </form>
    <div id="entries" class="card" style="margin-top:1.25rem">Loading…</div>
  </section>
</BaseLayout>
<script>
  const entries = document.getElementById('entries');
  const form = document.getElementById('gb-form');
  const status = document.getElementById('gb-status');
  async function load() {
    const res = await fetch('/api/guestbook');
    const data = await res.json();
    if (!res.ok) {
      entries.textContent = data.error || `HTTP ${res.status}`;
      return;
    }
    const list = data.entries || [];
    if (!list.length) {
      entries.replaceChildren(Object.assign(document.createElement('p'), { textContent: 'No entries yet.' }));
      return;
    }
    entries.replaceChildren(...list.map((e) => {
      const p = document.createElement('p');
      const name = document.createElement('strong');
      name.textContent = e.name;
      const when = document.createElement('small');
      when.textContent = e.created_at;
      p.append(name, `: ${e.message}`, document.createElement('br'), when);
      return p;
    }));
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        status.textContent = `Error: ${data.error || res.status}`;
        return;
      }
      status.textContent = 'Thanks for signing!';
      form.reset();
      await load();
    } catch (err) {
      status.textContent = 'Network error';
    }
  });
  load();
</script>

